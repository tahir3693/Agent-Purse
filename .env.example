# AgentPurse environment template. PLACEHOLDERS ONLY. Real values live in .env (git-ignored).
# Every name here is read by the code unless marked otherwise.
# `pnpm check:env-example` runs in the pre-commit hook and in CI.

# --- API server (Render sets PORT itself) ---
PORT="8080"
# HOST="0.0.0.0"   # optional; defaults to 0.0.0.0

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- Auth / signing (server only, at least 32 characters each) ---
JWT_SECRET="replace-with-your-value"
MANDATE_SIGNING_KEY="replace-with-your-value"

# --- Payments (Braintree sandbox) ---
PAYMENT_PROVIDER="braintree"
BRAINTREE_ENV="sandbox"
BRAINTREE_MERCHANT_ID="replace-with-your-value"
BRAINTREE_PUBLIC_KEY="replace-with-your-value"
BRAINTREE_PRIVATE_KEY="replace-with-your-value"

# Optional, read only when PAYMENT_PROVIDER=paypal. Uncomment to use.
# PAYPAL_CLIENT_ID="replace-with-your-value"
# PAYPAL_CLIENT_SECRET="replace-with-your-value"
# PAYPAL_WEBHOOK_ID="replace-with-your-value"
# PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# --- AI / catalog (server only) ---
ANTHROPIC_API_KEY="replace-with-your-value"
AI_MODEL="claude-sonnet-5-5"
CHANNEL3_API_KEY="replace-with-your-value"

# --- URLs ---
# Allowed browser origin(s) for the API, comma-separated.
WEB_ORIGIN="http://localhost:3000"
# Reserved: not read by the code yet (listed in render.yaml and steering).
APP_BASE_URL="http://localhost:3000"
# Web server-side (BFF) -> API.
API_BASE_URL="http://localhost:8080"

# --- Web (browser-visible; never put secrets here) ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"
NEXT_PUBLIC_AG_GRID_LICENSE_KEY="replace-with-your-value"
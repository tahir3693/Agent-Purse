# AgentPurse environment template. Placeholders only: copy to .env and fill in.
# Never commit real values.

# --- Core ---
DATABASE_URL=postgres://user:password@localhost:5432/agentpurse
JWT_SECRET=replace-with-64-hex-chars
MANDATE_SIGNING_KEY=replace-with-a-different-64-hex-chars

# --- Payments (Braintree sandbox, primary) ---
PAYMENT_PROVIDER=braintree
BRAINTREE_ENV=sandbox
BRAINTREE_MERCHANT_ID=69x5b9hsv2vnt422
BRAINTREE_PUBLIC_KEY=fg7h96wjnjrmwy2f
BRAINTREE_PRIVATE_KEY=972508521c951d627faf49678ad8edfa

# --- AI ---
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-sonnet-5-5

# --- Catalog ---
CHANNEL3_API_KEY=your-channel3-api-key

# --- URLs / CORS ---
WEB_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# --- Web (Next.js) ---
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Browser-side AG Grid license string (web only; replaces AG_GRID_LICENSE_KEY)
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=your-ag-grid-license-key

# --- Optional: only when PAYMENT_PROVIDER=paypal ---
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

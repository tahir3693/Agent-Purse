{
  "info": {
    "name": "AgentPurse API",
    "description": "Requests for the AgentPurse API, grouped by flow. Payments are Braintree sandbox transactions (a PayPal service); no real money moves.\n\nImport this collection and the environment file, set ownerEmail and ownerPassword (the judge login is in the Devpost testing instructions), then run folders 1 to 3 in order. Test scripts store ownerToken, ownerId, agentKey, agentId, paymentMethodId, intentId, mandateToken and streamToken in the environment. No secrets are stored in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System",
      "description": "No authentication.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Render health check. The free tier can take up to a minute to wake."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"status ok\", () => pm.expect(body.status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Owner setup",
      "description": "Register (once), sign in, create an agent, and link the Braintree sandbox test card. Set ownerEmail and ownerPassword in the environment first. The password is never stored in this repository.",
      "item": [
        {
          "name": "Register owner (skip if you already have an account)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Password must be at least 12 characters. Returns 201, or 409 if the email exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created or already registered\", () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Stores ownerToken and ownerId. The token lasts one hour."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has bearer token\", () => pm.expect(body.tokenType).to.eql(\"Bearer\"));",
                  "pm.environment.set(\"ownerToken\", body.accessToken);",
                  "pm.environment.set(\"ownerId\", body.ownerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-agent\",\n  \"policy\": {\n    \"dailyBudgetCents\": 50000,\n    \"perPurchaseCapCents\": 20000,\n    \"allowedCategories\": [\n      \"office\",\n      \"electronics\",\n      \"books\",\n      \"software\"\n    ],\n    \"blockedPayees\": [],\n    \"velocityPerHour\": 10,\n    \"velocityPerDay\": 30\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The API key is returned once. Stores agentKey and agentId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"api key returned\", () => pm.expect(body.apiKey).to.be.a(\"string\"));",
                  "pm.environment.set(\"agentKey\", body.apiKey);",
                  "pm.environment.set(\"agentId\", body.agent.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Link sandbox test card",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vault/link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vault",
                "link"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerId\": \"{{ownerId}}\",\n  \"nonce\": \"fake-valid-nonce\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Braintree sandbox nonce. 201 for a new link, 200 if already linked. Stores paymentMethodId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"linked\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"paymentMethodId\", body.method.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List payment methods",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vault/methods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vault",
                "methods"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has methods array\", () => pm.expect(body.methods).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List agents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has agents array\", () => pm.expect(body.agents).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get agent policy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/agents/{{agentId}}/policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "{{agentId}}",
                "policy"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Set agent policy",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/agents/{{agentId}}/policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "{{agentId}}",
                "policy"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dailyBudgetCents\": 50000,\n  \"perPurchaseCapCents\": 20000,\n  \"allowedCategories\": [\n    \"office\",\n    \"electronics\",\n    \"books\",\n    \"software\"\n  ],\n  \"blockedPayees\": [],\n  \"velocityPerHour\": 10,\n  \"velocityPerDay\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Unknown properties are rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Small purchase (auto-approve path)",
      "description": "Agent key. A small purchase with a normal price can be approved straight away; Risk Guard (including the AI review) makes the call, so the result is not guaranteed. If the decision is not approve, no mandate token is stored.",
      "item": [
        {
          "name": "Create intent (small)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountCents\": 999,\n  \"currency\": \"USD\",\n  \"payee\": \"example-shop.test\",\n  \"category\": \"electronics\",\n  \"description\": \"USB-C cable\",\n  \"justification\": \"Replacement charging cable for the team laptop dock.\",\n  \"paymentMethodRef\": \"{{paymentMethodId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201 with a mandateToken when approved; 200 when escalated or denied. Stores intentId and mandateToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created, escalated or denied\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"intentId\", body.intentId);",
                  "if (body.mandateToken) { pm.environment.set(\"mandateToken\", body.mandateToken); } else { pm.environment.unset(\"mandateToken\"); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get intent status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/intents/{{intentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents",
                "{{intentId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has state\", () => pm.expect(body.state).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Execute with mandate (capture)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/intents/{{intentId}}/execute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents",
                "{{intentId}}",
                "execute"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mandateToken\": \"{{mandateToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Consumes the single-use mandate and captures the payment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"captured\", () => pm.expect(body.state).to.eql(\"captured\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay the same mandate (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/intents/{{intentId}}/execute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents",
                "{{intentId}}",
                "execute"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mandateToken\": \"{{mandateToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A consumed token is rejected and nothing is captured twice."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Needs approval (owner in the loop)",
      "description": "An amount above the $50.00 auto-approve limit always escalates. The owner approves, then the agent fetches its mandate and executes.",
      "item": [
        {
          "name": "Create intent (above auto-approve limit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountCents\": 12000,\n  \"currency\": \"USD\",\n  \"payee\": \"example-shop.test\",\n  \"category\": \"electronics\",\n  \"description\": \"Mechanical keyboard\",\n  \"justification\": \"Ergonomic keyboard for a new team member.\",\n  \"paymentMethodRef\": \"{{paymentMethodId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expect 200 with decision escalate and state escalated. Stores intentId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"escalated\", () => pm.expect(body.decision).to.eql(\"escalate\"));",
                  "pm.environment.set(\"intentId\", body.intentId);",
                  "pm.environment.unset(\"mandateToken\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner: list escalated intents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/owner/intents?state=escalated&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owner",
                "intents"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "escalated"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has intents array\", () => pm.expect(body.intents).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner: approve",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/intents/{{intentId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents",
                "{{intentId}}",
                "approve"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Places the hold. Expect state authorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"authorized\", () => pm.expect(body.state).to.eql(\"authorized\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Agent: get mandate",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/intents/{{intentId}}/mandate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents",
                "{{intentId}}",
                "mandate"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            },
            "description": "One mandate per intent. Stores mandateToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"mandateToken\", body.mandateToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Agent: execute with mandate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/intents/{{intentId}}/execute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents",
                "{{intentId}}",
                "execute"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mandateToken\": \"{{mandateToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"captured\", () => pm.expect(body.state).to.eql(\"captured\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Owner: deny (use on a different escalated intent)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/intents/{{intentId}}/deny",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents",
                "{{intentId}}",
                "deny"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Closes an escalated intent without touching the payment provider. Returns 409 if it is no longer escalated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"denied or no longer escalated\", () => pm.expect([200, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Rules and price check",

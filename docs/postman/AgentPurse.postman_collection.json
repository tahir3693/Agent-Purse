                {
                  "key": "stream_token",
                  "value": "{{streamToken}}"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns text/event-stream. Cancel the request to close it."
          },
          "event": [
            {
              "listen": "test",
              "script": {

                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"text\": \"How much have my agents spent today?\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Response is NDJSON: one JSON event per line (note, text, error, done)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const lines = pm.response.text().split(\"\\n\").filter(Boolean).map((l) => JSON.parse(l));",
                  "pm.test(\"ends with done\", () => pm.expect(lines[lines.length - 1].type).to.eql(\"done\"));"
                ]
              }
            }
          ]
        }

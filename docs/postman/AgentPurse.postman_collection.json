          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "intents"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountCents\": 25000,\n  \"currency\": \"USD\",\n  \"payee\": \"example-shop.test\",\n  \"category\": \"electronics\",\n  \"description\": \"Premium keyboards\",\n  \"justification\": \"Premium keyboards for the whole team.\",\n  \"paymentMethodRef\": \"{{paymentMethodId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Assumes the policy cap of $200.00 from the sample policy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"denied\", () => pm.expect(body.decision).to.eql(\"deny\"));",
                  "pm.test(\"no mandate\", () => pm.expect(body.mandateToken).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Prompt injection in the justification (expect not approved)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",

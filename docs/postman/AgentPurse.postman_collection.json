    {
      "name": "7. Live events",
      "description": "Server-sent events. Postman shows the stream but is not ideal for long-lived connections.",
      "item": [
        {
          "name": "Mint stream token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "token"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Stores streamToken (valid 60 seconds)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"streamToken\", body.streamToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Open event stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?stream_token={{streamToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],

{
  "name": "agentpurse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentPurse monorepo — give your AI an allowance, not your credit card.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "check:env-example": "node scripts/check-env-example.mjs",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "channel3:smoke": "pnpm --filter @agentpurse/api channel3:smoke",
    "payments:smoke": "pnpm --filter @agentpurse/api payments:smoke",
    "paypal:smoke": "pnpm --filter @agentpurse/api paypal:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}

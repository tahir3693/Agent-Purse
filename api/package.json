{
  "name": "@agentpurse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "channel3:smoke": "node --env-file-if-exists=../.env --import tsx src/channel3/smoke.ts",
    "payments:smoke": "node --env-file-if-exists=../.env --import tsx src/payments/smoke.ts",
    "paypal:smoke": "node --env-file-if-exists=../.env --import tsx src/paypal/smoke.ts"
  },
  "dependencies": {
    "@agentpurse/shared": "workspace:*",
    "@channel3/sdk": "^4.8.0",
    "@prisma/client": "6.19.0",
    "braintree": "^3.41.0",
    "fastify": "^5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/braintree": "^3.4.5",
    "prisma": "6.19.0",
    "tsx": "^4.19.2"
  }
}
